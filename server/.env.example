PORT=5000
MONGODB_URI=MongoDB Atlas mongodb+srv:// connection string, database name text-to-learn
AUTH0_ISSUER_BASE_URL=https:// + tenant domain + trailing /
AUTH0_AUDIENCE=API Identifier, identical to VITE_AUTH0_AUDIENCE
CLIENT_ORIGIN=http://localhost:5173 (CORS)
GEMINI_API_KEY=Google AI Studio API key for Gemini
GEMINI_MODEL=Gemini model name used for course generation, e.g. gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=Optional. Second model tried when the first is busy or slow, e.g. gemini-3.5-flash
LESSON_GEN_CONCURRENCY=Optional. Max simultaneous lesson-writing Gemini calls across courses, default 2
LESSON_ATTEMPT_TIMEOUT_MS=Optional. Per-attempt timeout for writing one lesson, default 60000
LESSON_TOTAL_TIMEOUT_MS=Optional. Overall timeout for writing one lesson across retries, default 120000
GEMINI_TTS_MODEL=Optional. Gemini text-to-speech model for Hinglish audio, default gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=Optional. Second TTS model tried when the first is busy, e.g. gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Optional. Prebuilt TTS voice name, default Sulafat (warm); also try Achird or Charon
AUDIO_GEN_CONCURRENCY=Optional. Max Hinglish audio jobs running at once, default 1
AUDIO_DAILY_LIMIT_PER_USER=Optional. New Hinglish audio jobs a user may start per UTC day, default 10
AUDIO_TOTAL_TIMEOUT_MS=Optional. Overall deadline for one Hinglish audio job, default 300000
YOUTUBE_API_KEY=Optional. YouTube Data API v3 key for module videos; server only, never a VITE_ variable. Without it, new searches report that videos are unavailable
YOUTUBE_REGION_CODE=Optional. Two-letter country whose viewable videos are searched, default IN
VIDEO_GEN_CONCURRENCY=Optional. Max module video jobs running at once, default 2
VIDEO_DAILY_LIMIT_PER_USER=Optional. New video searches a user may start per UTC day, default 20
