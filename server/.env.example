PORT=5000
MONGODB_URI=MongoDB Atlas mongodb+srv:// connection string, database name text-to-learn
AUTH0_ISSUER_BASE_URL=https:// + tenant domain + trailing /
AUTH0_AUDIENCE=API Identifier, identical to VITE_AUTH0_AUDIENCE
CLIENT_ORIGIN=http://localhost:5173 (CORS)
GEMINI_API_KEY=Google AI Studio API key for Gemini
GEMINI_MODEL=Gemini model name used for course generation, e.g. gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=Optional. Second model tried when the first is busy or slow, e.g. gemini-3.5-flash
